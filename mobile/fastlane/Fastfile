# iOS release lane, run by .github/workflows/mobile-release.yml on a macOS runner
# after `expo prebuild --platform ios`. Inputs (from the `release` environment,
# created by scripts/mobile/setup-signing.sh):
#   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_P8_B64   App Store Connect API key
#   IOS_DIST_P12_PATH, IOS_DIST_P12_PASSWORD    distribution certificate (.p12)
#   KEYCHAIN_PASSWORD                           throwaway, generated by the job
#   APPLE_TEAM_ID                               repository variable (not secret)
default_platform(:ios)

KEYCHAIN = "kergui-ci.keychain".freeze

platform :ios do
  desc "Build a signed .ipa and upload it to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8_B64"),
      is_key_content_base64: true,
      in_house: false
    )

    create_keychain(
      name: KEYCHAIN,
      password: ENV.fetch("KEYCHAIN_PASSWORD"),
      default_keychain: false,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )
    import_certificate(
      certificate_path: ENV.fetch("IOS_DIST_P12_PATH"),
      certificate_password: ENV.fetch("IOS_DIST_P12_PASSWORD"),
      keychain_name: KEYCHAIN,
      keychain_password: ENV.fetch("KEYCHAIN_PASSWORD")
    )

    # Downloads the App Store profile for the bundle id, creating it on first run.
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: "org.kergui.app",
      readonly: false
    )

    update_code_signing_settings(
      path: "ios/Kergui.xcodeproj",
      use_automatic_signing: false,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      targets: ["Kergui"],
      code_sign_identity: "Apple Distribution",
      profile_uuid: lane_context[SharedValues::SIGH_UUID],
      profile_name: lane_context[SharedValues::SIGH_NAME]
    )

    build_app(
      workspace: "ios/Kergui.xcworkspace",
      scheme: "Kergui",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      export_options: {
        provisioningProfiles: { "org.kergui.app" => lane_context[SharedValues::SIGH_NAME] }
      },
      xcargs: "OTHER_CODE_SIGN_FLAGS='--keychain #{File.expand_path("~/Library/Keychains/#{KEYCHAIN}-db")}'"
    )

    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end

  after_all { delete_keychain(name: KEYCHAIN) if File.exist?(File.expand_path("~/Library/Keychains/#{KEYCHAIN}-db")) }
  error { delete_keychain(name: KEYCHAIN) if File.exist?(File.expand_path("~/Library/Keychains/#{KEYCHAIN}-db")) }
end
