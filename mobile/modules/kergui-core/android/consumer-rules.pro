# The Go core (gomobile) is reached from native code through JNI, which looks
# classes and methods up by name. R8 must neither rename nor remove them, or
# the app dies at launch when libgojni initialises.
-keep class go.** { *; }
-keep class org.kergui.mobilecore.** { *; }
-keepclasseswithmembernames class * { native <methods>; }

# expo-background-task runs on WorkManager, whose Room database is created by
# reflection (WorkDatabase_Impl.<init>). R8 strips that constructor in release
# builds and the app dies at launch in InitializationProvider. The rule sits
# here because android/ is regenerated by prebuild and this file is not.
-keep class * extends androidx.room.RoomDatabase { <init>(); }
