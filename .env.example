# Router used by `make serve`.
export KERGUI_ROUTER_URL='https://192.168.1.1'
export KERGUI_ADAPTER='zte_f6600p'

# Payments: NabooPay v2 API key (platform.naboopay.com). Empty = payments off.
export KERGUI_NABOOPAY_API_KEY='pk_live_naboo_EOCe_hjtDT9JXjpSegppFkLkLAKzsMJW1XhsFEKSASA='
# Leave empty for production.
