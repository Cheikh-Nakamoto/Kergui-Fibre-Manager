export KERGUI_MASTER_KEY='buibvsuv bsfBVIbPhb'yè_zry_ryviPVPRgiqeubiuàqhe_çhçhqçetèh(çuçq_eçubuçthçb"hbçhethç)'

# Optional: router admin password (otherwise save it once from Réglages).
