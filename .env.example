# Extra sites a cut device may reach to pay (comma-separated). NabooPay, Wave
# and Orange Money are always allowed; the journal names any missing site.
KERGUI_CAPTIVE_ALLOW=''

# Public pages the payer returns to after paying.
export KERGUI_PUBLIC_URL='https://pay.cheikhmodiouf.org'
