# kergui-hub settings. Copy to hub.env (gitignored) and fill in.
# Postgres password, used by both containers.
KERGUI_HUB_DB_PASSWORD=
# HS256 secret for access tokens, at least 32 bytes: openssl rand -base64 48
KERGUI_HUB_JWT_SECRET=
# Public URL of the hub (links in emails).
KERGUI_HUB_PUBLIC_URL=https://hub.example.org
# production (default) hides internal details from error responses.
KERGUI_HUB_ENV=production
# true when the hub is reached through Cloudflare (rate limits use CF-Connecting-IP).
KERGUI_HUB_TRUST_CLOUDFLARE=false
KERGUI_HUB_MAIL_FROM=Kergui <no-reply@example.org>
# Leave KERGUI_HUB_SMTP_HOST empty to log emails instead of sending them.
KERGUI_HUB_SMTP_HOST=
KERGUI_HUB_SMTP_PORT=587
KERGUI_HUB_SMTP_USER=
KERGUI_HUB_SMTP_PASSWORD=
KERGUI_HUB_SMTP_TLS=false

# --- Alerts (RFC-005 H2) ----------------------------------------------------
# console (default) writes the messages it would send to the hub's log, which
# is what a pilot without a WhatsApp number should use. evolution sends them
# through a self-hosted Evolution Go instance.
KERGUI_HUB_NOTIFIER=console
# The household-facing Kergui number, E.164. The wa.me opt-in link points at
# it, so without it no number can be linked.
KERGUI_HUB_WHATSAPP_NUMBER=
# Authenticates the provider's inbound calls, which arrive on
# /whatsapp/v1/inbound/<secret>: Evolution Go signs nothing, so the secret is
# the path. At least 24 characters: openssl rand -hex 24
KERGUI_HUB_WEBHOOK_SECRET=
# Derives each household's narrow "reply 1 to block" key. Leave empty and
# replying 1 does nothing (the household is told to use the app). At least 32
# bytes: openssl rand -hex 32. Losing it only loses that shortcut; leaking it
# risks one unprotected device being blocked, rate-limited, and only while the
# owner's bundle still delegates it.
KERGUI_HUB_KEY_SEED=

# --- Evolution Go, only with KERGUI_HUB_NOTIFIER=evolution -------------------
# Evolution Go is licensed Apache-2.0 with brand conditions: its instance must
# be registered in its Manager before it will send anything (it answers 503
# until then), and any system using it has to show a visible notice saying so.
# The hub does that through its WhatsApp settings route and its start-up log.
KERGUI_HUB_EVOLUTION_URL=
KERGUI_HUB_EVOLUTION_INSTANCE=
KERGUI_HUB_EVOLUTION_APIKEY=

# Optional: KERGUI_HUB_TOKEN_TTL=15m  KERGUI_HUB_REFRESH_TTL=720h  KERGUI_HUB_LOG_LEVEL=info
