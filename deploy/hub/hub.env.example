# kergui-hub settings. Copy to hub.env (gitignored) and fill in.
# --- Production (docs/hub-production.md) -------------------------------------
# The image CI pushes on a hub-v* tag, and the version to run (the tag without
# "hub-v", e.g. 0.2.0). Rollback = set the previous version, `up -d hub`.
KERGUI_HUB_IMAGE=ghcr.io/cheikh-nakamoto/kergui-hub
KERGUI_HUB_VERSION=
# The Cloudflare tunnel's token (compose profile "tunnel"). Never commit it.
KERGUI_CLOUDFLARE_TUNNEL_TOKEN=

# Postgres password, used by both containers.
KERGUI_HUB_DB_PASSWORD=
# HS256 secret for access tokens, at least 32 bytes: openssl rand -base64 48
KERGUI_HUB_JWT_SECRET=
# Public URL of the hub (links in emails).
KERGUI_HUB_PUBLIC_URL=https://hub.example.org
# production (default) hides internal details from error responses.
KERGUI_HUB_ENV=production
# true when the hub is reached through Cloudflare (rate limits use CF-Connecting-IP).
KERGUI_HUB_TRUST_CLOUDFLARE=false
KERGUI_HUB_MAIL_FROM=Kergui <no-reply@example.org>
# Leave KERGUI_HUB_SMTP_HOST empty to log emails instead of sending them.
KERGUI_HUB_SMTP_HOST=
KERGUI_HUB_SMTP_PORT=587
KERGUI_HUB_SMTP_USER=
KERGUI_HUB_SMTP_PASSWORD=
KERGUI_HUB_SMTP_TLS=false

# --- Alerts (RFC-005 H2) ----------------------------------------------------
# console (default) writes the messages it would send to the hub's log, which
# is what a pilot without a WhatsApp number should use. whatsmeow sends and
# receives them through a WhatsApp Web session inside the hub (no extra
# service), linked once from the admin route: docs/hub-whatsapp.md.
KERGUI_HUB_NOTIFIER=console
# The household-facing Kergui number, E.164. The wa.me opt-in link points at
# it, so without it no number can be linked.
KERGUI_HUB_WHATSAPP_NUMBER=
# Only for the console provider (tests, pilots): authenticates its inbound
# calls on /whatsapp/v1/inbound/<secret>. whatsmeow needs none. At least 24
# characters: openssl rand -hex 24
KERGUI_HUB_WEBHOOK_SECRET=
# Derives each household's narrow "reply 1 to block" key. Leave empty and
# replying 1 does nothing (the household is told to use the app). At least 32
# bytes: openssl rand -hex 32. Losing it only loses that shortcut; leaking it
# risks one unprotected device being blocked, rate-limited, and only while the
# owner's bundle still delegates it.
KERGUI_HUB_KEY_SEED=

# --- App push (issue #49) ----------------------------------------------------
# console (default) logs the notifications the hub would push to the app;
# expo hands them to Expo's push service, which delivers them over FCM
# (Android) and APNs (iOS) with the app closed. Before expo works, once: the
# app's EAS project has its Firebase (FCM v1) service account uploaded
# (eas credentials, Android > Push Notifications), and the build carries the
# EAS project id (KERGUI_EAS_PROJECT_ID for app.config.js).
KERGUI_HUB_PUSH_PROVIDER=console
# Only when the EAS project has "enhanced security for push notifications"
# on: its push access token. Never commit it.
KERGUI_HUB_EXPO_ACCESS_TOKEN=

# --- Pro passes (RFC-006) ----------------------------------------------------
# Ed25519 key that signs the app's entitlement tokens. Never commit it. Either
# inline (PEM, or a 32-byte seed in base64/hex) or, better, a mounted secret
# file: openssl genpkey -algorithm ed25519 -out licensing.key
# Leave both empty and the hub sells no passes (the /licensing/v1 routes are off).
KERGUI_HUB_LICENSING_SIGNING_KEY=
KERGUI_HUB_LICENSING_SIGNING_KEY_FILE=
# Signing key rotation (docs/licensing-key-rotation.md): public keys (raw 32
# bytes, base64) published beside the active key, before it signs (next) and
# after (retiring), and the key ids whose tokens are refused (revoked). Comma
# or space separated. Empty outside a rotation.
KERGUI_HUB_LICENSING_NEXT_PUBLIC_KEYS=
KERGUI_HUB_LICENSING_RETIRING_PUBLIC_KEYS=
KERGUI_HUB_LICENSING_REVOKED_KEY_IDS=
# NabooPay (Wave / Orange Money) for the direct-APK flavor. Without the API key
# no checkout is opened and reminders carry no payment link.
KERGUI_HUB_NABOOPAY_API_KEY=
# Leave empty for production (https://api.naboopay.com).
KERGUI_HUB_NABOOPAY_BASE_URL=
# Authenticates NabooPay's webhook (X-Signature) on
# /licensing/v1/webhooks/naboopay. Without it, pending orders are still settled
# by the periodic sweep.
KERGUI_HUB_NABOOPAY_WEBHOOK_SECRET=
# Optional: where NabooPay sends the payer back (default
# <KERGUI_HUB_PUBLIC_URL>/licensing/v1/checkout/done), and how often expiry
# reminders go out and pending orders are re-checked.
# KERGUI_HUB_LICENSING_RETURN_URL=  KERGUI_HUB_LICENSING_SWEEP_INTERVAL=10m

# --- Google Play Billing, for the play flavor (RFC-006, Two channels) --------
# Subscriptions kergui_basic / kergui_max (monthly base plans; the trial is an
# offer set in the Play Console). Leave the package empty and the
# /licensing/v1/play routes answer 404 (PLAY_OFF). Needs the signing key above.
KERGUI_HUB_PLAY_PACKAGE_NAME=
# Google service account key (JSON) the hub calls the Play Developer API with:
# invite it in Play Console > Users and permissions with "View financial
# data" and "Manage orders and subscriptions". Inline or, better, a mounted
# secret file, never both.
KERGUI_HUB_PLAY_SERVICE_ACCOUNT_JSON=
KERGUI_HUB_PLAY_SERVICE_ACCOUNT_FILE=
# Real-time Developer Notifications: a Pub/Sub topic set in the Play Console,
# with a push subscription to <KERGUI_HUB_PUBLIC_URL>/licensing/v1/webhooks/play
# and authentication on. Set here the email of the service account the push
# signs its OIDC token as: the hub checks the token against Google's keys, the
# audience and this email (anyone can get a Google-signed token for any
# audience, so the email is what proves the push is yours). Empty turns the
# webhook off; the app's call on launch still picks up renewals.
KERGUI_HUB_PLAY_RTDN_SERVICE_ACCOUNT=
# Optional: the push subscription's audience, if not the default (the
# webhook's URL).
# KERGUI_HUB_PLAY_RTDN_AUDIENCE=

# Optional: KERGUI_HUB_TOKEN_TTL=15m  KERGUI_HUB_REFRESH_TTL=720h  KERGUI_HUB_LOG_LEVEL=info
